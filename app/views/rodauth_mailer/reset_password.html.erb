<% content_for :preheader do %><%= t('mailers.password_reset.intro', default: 'We received a request to reset the password for your account.') %><% end %>

<h1 style="margin: 0 0 18px; color: #111827; font-size: 24px; line-height: 1.25; font-weight: 700;"><%= t('mailers.password_reset.greeting', default: 'Reset your password') %></h1>

<p style="margin: 0 0 16px; color: #374151; font-size: 16px; line-height: 1.6;"><%= t('mailers.password_reset.intro', default: 'We received a request to reset the password for your account.') %></p>
<p style="margin: 0 0 16px; color: #374151; font-size: 16px; line-height: 1.6;"><%= t('mailers.password_reset.instructions', default: 'Click the button below to set a new password.') %></p>

<%= render 'shared/mailer_button', text: t('mailers.password_reset.cta', default: 'Reset Password'), url: @rodauth.reset_password_email_link %>

<p class="note" style="margin: 0 0 16px; color: #6b7280; font-size: 14px; line-height: 1.6;"><%= t('mailers.password_reset.ignore', default: 'If you did not request this, you can safely ignore this email.') %></p>
