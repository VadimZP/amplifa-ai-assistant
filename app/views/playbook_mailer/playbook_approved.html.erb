<% content_for :preheader do %><%= t('mailers.playbook.approved.body', product: @playbook.product_name, organization: @organization.name, approver: @approved_by.full_name) %><% end %>

<h1 style="margin: 0 0 18px; color: #111827; font-size: 24px; line-height: 1.25; font-weight: 700;"><%= t('mailers.playbook.approved.greeting') %></h1>

<p style="margin: 0 0 16px; color: #374151; font-size: 16px; line-height: 1.6;">
  <%= t('mailers.playbook.approved.body', product: @playbook.product_name, organization: @organization.name, approver: @approved_by.full_name) %>
</p>

<%= render 'shared/mailer_details', rows: [[t('mailers.conversation_forward.lead_company', default: 'Company'), @organization.name], ['Playbook', @playbook.product_name]] %>

<%= render 'shared/mailer_button', text: t('mailers.playbook.approved.cta'), url: playbook_url(@playbook) %>
