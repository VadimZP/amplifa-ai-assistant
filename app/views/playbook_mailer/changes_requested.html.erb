<% content_for :preheader do %><%= t('mailers.playbook.changes_requested.body', organization: @organization.name, product: @playbook.product_name, requester: @requested_by.full_name) %><% end %>

<h1 style="margin: 0 0 18px; color: #111827; font-size: 24px; line-height: 1.25; font-weight: 700;"><%= t('mailers.playbook.changes_requested.greeting') %></h1>

<p style="margin: 0 0 16px; color: #374151; font-size: 16px; line-height: 1.6;">
  <%= t('mailers.playbook.changes_requested.body', organization: @organization.name, product: @playbook.product_name, requester: @requested_by.full_name) %>
</p>

<div class="quote-box" style="margin: 22px 0; padding: 16px 18px; background-color: #fff7ed; border-left: 4px solid #f59e0b; border-radius: 10px;">
  <p style="margin: 0; color: #374151; font-size: 16px; line-height: 1.6;"><%= simple_format(@comment.body, {}, wrapper_tag: 'span') %></p>
</div>

<%= render 'shared/mailer_button', text: t('mailers.playbook.changes_requested.cta'), url: admin_organization_url(@playbook.organization) %>
