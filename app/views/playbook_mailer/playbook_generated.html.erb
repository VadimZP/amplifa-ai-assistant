<% content_for :preheader do %><%= t('mailers.playbook.generated.body', product: @product_name, organization: @organization.name, initiated_by: @initiated_by.full_name, persona_count: @playbook.persona_count, use_case_count: @playbook.use_case_count) %><% end %>

<h1 style="margin: 0 0 18px; color: #111827; font-size: 24px; line-height: 1.25; font-weight: 700;"><%= t('mailers.playbook.generated.greeting') %></h1>

<p style="margin: 0 0 16px; color: #374151; font-size: 16px; line-height: 1.6;">
  <%= t('mailers.playbook.generated.body', product: @product_name, organization: @organization.name, initiated_by: @initiated_by.full_name, persona_count: @playbook.persona_count, use_case_count: @playbook.use_case_count) %>
</p>

<%= render 'shared/mailer_details', rows: [
  [t('mailers.conversation_forward.lead_company', default: 'Company'), @organization.name],
  ['Playbook', @product_name],
  ['Personae', @playbook.persona_count],
  ['Use cases', @playbook.use_case_count]
] %>

<%= render 'shared/mailer_button', text: t('mailers.playbook.generated.cta'), url: admin_organization_url(@playbook.organization) %>
