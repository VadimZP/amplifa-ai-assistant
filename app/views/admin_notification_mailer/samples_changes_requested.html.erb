<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); padding: 30px; border-radius: 8px 8px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 24px;">📝 Changes Requested</h1>
  </div>
  
  <div style="background: #fff; padding: 30px; border: 1px solid #e0e0e0; border-top: none; border-radius: 0 0 8px 8px;">
    <p>Hi Team,</p>
    
    <p><strong><%= @requester.full_name %></strong> from <strong><%= @organization.name %></strong> has requested changes to the sample messages for:</p>
    
    <div style="background: #f8f9fa; border-left: 4px solid #f59e0b; padding: 15px; margin: 20px 0;">
      <p style="margin: 0;"><strong>Agent:</strong> <%= @agent.name %></p>
      <p style="margin: 5px 0 0;"><strong>Requested by:</strong> <%= @requester.full_name %> (<%= @requester.email %>)</p>
      <% if @lead.present? %>
        <p style="margin: 5px 0 0;"><strong>Lead in view:</strong> <%= @lead.display_name %> (<%= @lead.email %>)</p>
      <% end %>
    </div>
    
    <h3 style="margin: 25px 0 10px;">Feedback:</h3>
    <div style="background: #fff3cd; border: 1px solid #ffc107; padding: 15px; border-radius: 6px;">
      <p style="margin: 0; white-space: pre-wrap;"><%= @feedback %></p>
    </div>
    
    <p style="margin-top: 20px;">Please review and regenerate the samples based on this feedback.</p>
    
    <p style="margin-top: 30px;">
      <a href="<%= admin_organization_url(@organization) %>" style="display: inline-block; background: #667eea; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600;">View Agent</a>
    </p>
    
    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 30px 0;">
    
    <p style="color: #666; font-size: 14px;">
      This is an automated notification from Amplifa.
    </p>
  </div>
</body>
</html>
