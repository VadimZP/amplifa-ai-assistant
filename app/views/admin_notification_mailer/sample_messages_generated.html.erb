<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px; border-radius: 8px 8px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 24px;">🎯 Sample Messages Generated</h1>
  </div>
  
  <div style="background: #fff; padding: 30px; border: 1px solid #e0e0e0; border-top: none; border-radius: 0 0 8px 8px;">
    <p>Hi Team,</p>
    
    <p>Sample messages have been generated for:</p>
    
    <div style="background: #f8f9fa; border-left: 4px solid #667eea; padding: 15px; margin: 20px 0;">
      <p style="margin: 0;"><strong>Agent:</strong> <%= @agent.name %></p>
      <p style="margin: 5px 0 0;"><strong>Organization:</strong> <%= @organization.name %></p>
      <p style="margin: 5px 0 0;"><strong>Initiated by:</strong> <%= @initiated_by.full_name %> (<%= @initiated_by.email %>)</p>
    </div>
    
    <div style="background: #e8f5e9; border-radius: 6px; padding: 15px; margin: 20px 0;">
      <p style="margin: 0;"><strong>Generated:</strong> <%= @generated_count %> leads</p>
      <% if @error_count > 0 %>
        <p style="margin: 5px 0 0; color: #c62828;"><strong>Errors:</strong> <%= @error_count %> leads</p>
      <% end %>
    </div>
    
    <p>The sample messages are ready for customer review.</p>
    
    <p style="margin-top: 30px;">
      <a href="<%= admin_organization_url(@organization) %>" style="display: inline-block; background: #667eea; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600;">View Agent</a>
    </p>
    
    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 30px 0;">
    
    <p style="color: #666; font-size: 14px;">
      This is an automated notification from Amplifa.
    </p>
  </div>
</body>
</html>
