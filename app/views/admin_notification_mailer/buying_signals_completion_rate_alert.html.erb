<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); padding: 30px; border-radius: 8px 8px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 24px;">Buying Signals Completion Rate Alert</h1>
  </div>

  <div style="background: #fff; padding: 30px; border: 1px solid #e0e0e0; border-top: none; border-radius: 0 0 8px 8px;">
    <p>Hi Team,</p>

    <p>Buying signals enrichment completion rate is below the configured threshold.</p>

    <div style="background: #ffebee; border-left: 4px solid #dc3545; padding: 15px; margin: 20px 0;">
      <p style="margin: 0;"><strong>Window:</strong> <%= @window_minutes %> minutes</p>
      <p style="margin: 5px 0 0;"><strong>Completion rate:</strong> <%= @completion_rate_percent %>%</p>
      <p style="margin: 5px 0 0;"><strong>Threshold:</strong> <%= @threshold_percent %>%</p>
      <p style="margin: 5px 0 0;"><strong>Completed:</strong> <%= @completed_count %></p>
      <p style="margin: 5px 0 0;"><strong>Failed:</strong> <%= @failed_count %></p>
      <p style="margin: 5px 0 0;"><strong>Total finalized:</strong> <%= @total_count %></p>
    </div>
  </div>
</body>
</html>
