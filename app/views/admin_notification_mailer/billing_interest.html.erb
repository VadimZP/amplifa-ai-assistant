<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <h2 style="margin-top: 0;">Billing interest clicked</h2>

  <p><strong>Event:</strong> <%= @account.full_name %> clicked a billing/upgrade CTA from the customer app.</p>
  <p><strong>Clicked button:</strong> <%= @action_label %></p>
  <p><strong>Organization:</strong> <%= @organization.name %> (ID: <%= @organization.id %>)</p>
  <p><strong>Account:</strong> <%= @account.full_name %> &lt;<%= @account.email %>&gt;</p>
  <% if @lead.present? %>
    <p><strong>Lead:</strong> <%= @lead.display_name %> &lt;<%= @lead.email %>&gt;</p>
    <p><strong>Lead company:</strong> <%= @lead.company.presence || '—' %></p>
    <p><strong>Lead job title:</strong> <%= @lead.job_title.presence || '—' %></p>
  <% end %>
  <p><strong>At:</strong> <%= Time.current.strftime('%B %d, %Y at %I:%M %p') %></p>
</body>
</html>
