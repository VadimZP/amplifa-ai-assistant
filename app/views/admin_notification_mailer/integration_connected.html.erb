<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 30px; border-radius: 8px 8px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 24px;">✅ Integration Connected</h1>
  </div>

  <div style="background: #fff; padding: 30px; border: 1px solid #e0e0e0; border-top: none; border-radius: 0 0 8px 8px;">
    <p>Hi Team,</p>

    <p>A customer successfully connected an integration.</p>

    <div style="background: #f8f9fa; border-left: 4px solid #10b981; padding: 15px; margin: 20px 0;">
      <p style="margin: 0;"><strong>Integration:</strong> <%= @integration_name %></p>
      <p style="margin: 5px 0 0;"><strong>Organization:</strong> <%= @organization.name %> (ID: <%= @organization.id %>)</p>
      <p style="margin: 5px 0 0;"><strong>User:</strong> <%= @account.full_name %> (<%= @account.email %>)</p>
      <p style="margin: 5px 0 0;"><strong>API Key:</strong> <code style="background: #f0f0f0; padding: 2px 6px; border-radius: 3px; font-family: monospace; font-size: 12px;"><%= @api_key %></code></p>
      <p style="margin: 5px 0 0;"><strong>At:</strong> <%= Time.current.strftime('%B %d, %Y at %I:%M %p') %></p>
    </div>

    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 30px 0;">

    <p style="color: #666; font-size: 14px;">
      This is an automated notification from Amplifa.
    </p>
  </div>
</body>
</html>
