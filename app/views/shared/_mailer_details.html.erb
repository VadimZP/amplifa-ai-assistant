<div class="details" style="margin: 24px 0; padding: 18px 20px; background-color: #f8fafc; border: 1px solid #e5e7eb; border-radius: 14px;">
  <% rows.each do |label, value| %>
    <p style="margin: 0 0 10px; color: #374151; font-size: 16px; line-height: 1.5;"><strong style="color: #111827;"><%= label %>:</strong> <%= value %></p>
  <% end %>
</div>
