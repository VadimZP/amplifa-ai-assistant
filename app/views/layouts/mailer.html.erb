<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      body { margin: 0; padding: 0; background-color: #f6f7fb; color: #243042; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
      .container { width: 100%; max-width: 640px; margin: 0 auto; }
      .email-card { background-color: #ffffff; border: 1px solid #e6e9f0; border-radius: 18px; overflow: hidden; }
      .email-header { padding: 32px 36px 24px; text-align: center; border-bottom: 1px solid #eef1f6; }
      .content { padding: 34px 36px 10px; }
      .content h1 { margin: 0 0 18px; color: #111827; font-size: 24px; line-height: 1.25; font-weight: 700; }
      .content p { margin: 0 0 16px; color: #374151; font-size: 16px; line-height: 1.6; }
      .button-container { margin: 30px 0; }
      .button { display: inline-block; padding: 14px 22px; background-color: #4f46e5; color: #ffffff !important; border-radius: 10px; font-size: 15px; font-weight: 700; line-height: 1.2; text-decoration: none; }
      .details { margin: 24px 0; padding: 18px 20px; background-color: #f8fafc; border: 1px solid #e5e7eb; border-radius: 14px; }
      .details p { margin: 0 0 10px; }
      .details p:last-child { margin-bottom: 0; }
      .note { color: #6b7280 !important; font-size: 14px !important; }
      .quote-box { margin: 22px 0; padding: 16px 18px; background-color: #f8fafc; border-left: 4px solid #4f46e5; border-radius: 10px; }
      .quote-box p { margin: 0; }
      .footer { padding: 22px 36px 34px; color: #6b7280; font-size: 13px; line-height: 1.5; }
      .footer p { margin: 0; }
      a { color: #4f46e5; }
      strong { color: #111827; }
      @media only screen and (max-width: 680px) {
        .container { max-width: 100% !important; }
        .email-card { border-radius: 0 !important; border-left: 0 !important; border-right: 0 !important; }
        .email-header, .content, .footer { padding-left: 22px !important; padding-right: 22px !important; }
      }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f6f7fb; color: #243042; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">
      <%= content_for?(:preheader) ? yield(:preheader) : 'Amplifa notification' %>
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; background-color: #f6f7fb; margin: 0; padding: 28px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" class="container" width="640" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 640px; margin: 0 auto;">
            <tr>
              <td class="email-card" style="background-color: #ffffff; border: 1px solid #e6e9f0; border-radius: 18px; overflow: hidden;">
                <div class="email-header" style="padding: 32px 36px 24px; text-align: center; border-bottom: 1px solid #eef1f6;">
                  <a href="<%= root_url %>" style="display: block; text-align: center; text-decoration: none;">
                    <%= image_tag('https://amplifa.ai/assets/amplifa-logo-WIcHTRhQ.png', alt: 'Amplifa', width: 140, style: 'display: block; width: 140px; height: auto; margin: 0 auto; border: 0;') %>
                  </a>
                </div>

                <div class="content" style="padding: 34px 36px 10px;">
                  <%= yield %>
                </div>

                <div class="footer" style="padding: 22px 36px 34px; color: #6b7280; font-size: 13px; line-height: 1.5;">
                  <p style="margin: 0;"><%= t('mailers.signature', default: 'Best regards,<br>The Amplifa Team').html_safe %></p>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
